---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="페이지를 찾을 수 없습니다 | 주다훤 포트폴리오"
  description="요청하신 페이지를 찾을 수 없습니다."
>
  <main
    class="flex min-h-[70vh] flex-col items-center justify-center px-4 py-16 text-center"
  >
    <h1 class="font-paperlogy mb-4 text-6xl font-bold">4 0 4</h1>
    <h2 class="font-pretendard mb-8 text-2xl">페이지를 찾을 수 없습니다</h2>
    <p class="text-gray-3 mb-8 max-w-md">
      요청하신 페이지가 삭제되었거나, 이름이 변경되었거나, 일시적으로 사용할 수
      없습니다.
    </p>
    <a
      href="/"
      class="bg-accent-1 hover:bg-accent-1/90 text-inverse rounded-lg px-6 py-3 font-bold transition-colors"
    >
      홈으로 돌아가기
    </a>
  </main>
</Layout>
