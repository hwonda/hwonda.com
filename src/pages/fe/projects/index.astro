---
import ProjectsPage from '@/components/projects/ProjectsPage';
import { projectsData } from '@/constants/fe/projectsData';
import Layout from '@/layouts/Layout.astro';

const title = '프로젝트 | 주다훤 포트폴리오';
const description =
  '주다훤의 프론트엔드 프로젝트 모음입니다. 다양한 웹 개발 프로젝트를 확인해보세요.';
---

<Layout
  title={title}
  description={description}
  canonicalURL={new URL('/fe/projects', Astro.site).toString()}
  basePath="/fe"
>
  <ProjectsPage client:load projectsData={projectsData} basePath="/fe" />
</Layout>
