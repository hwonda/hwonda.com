---
import ProjectsPage from '@/components/projects/ProjectsPage';
import { projectsData } from '@/constants/tpm/projectsData';
import Layout from '@/layouts/Layout.astro';

const title = '프로젝트 | 주다훤 포트폴리오';
const description =
  '주다훤의 TPM 프로젝트 모음입니다. 프로젝트 관리 및 기술 리딩 경험을 확인해보세요.';
---

<Layout
  title={title}
  description={description}
  canonicalURL={new URL('/tpm/projects', Astro.site).toString()}
  basePath="/tpm"
>
  <ProjectsPage client:load projectsData={projectsData} basePath="/tpm" />
</Layout>
