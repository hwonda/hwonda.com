---
import HomePage from '@/components/home/HomePage.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="주다훤 포트폴리오"
  description="주다훤의 TPM 포트폴리오입니다. 기술에 대한 깊은 이해를 바탕으로 프로젝트를 성공적으로 이끈 경험을 확인하실 수 있습니다."
  image="/images/home-og-image.png"
  canonicalURL={new URL('/tpm', Astro.site).toString()}
  basePath="/tpm"
>
  <HomePage basePath="/tpm" role="tpm" />
</Layout>
