---
import { About as AboutComponent } from '@/components/about';
import { personalInfo } from '@/constants/common/personalInfo';
import {
  aboutParagraphs,
  education,
  experiences,
} from '@/constants/pm/aboutConst';
import { techStacks } from '@/constants/pm/techStackConst';
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="소개 | 주다훤 포트폴리오"
  description="Technical Project Manager 주다훤의 소개 페이지입니다. 경력, 기술 스택, 그리고 교육 배경에 대한 정보를 확인하세요."
  canonicalURL={new URL('/pm/about', Astro.site).toString()}
  basePath="/pm"
>
  <AboutComponent
    name={personalInfo.name}
    title="Project Manager"
    profileImage={personalInfo.profileImage}
    email={personalInfo.email}
    github={personalInfo.github}
    linkedin={personalInfo.linkedin}
    techStacks={techStacks}
    aboutParagraphs={aboutParagraphs}
    experiences={experiences}
    education={education}
    role="pm"
    client:load
  />
</Layout>
