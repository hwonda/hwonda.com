---
import ImageCarouselWrapper from '@/components/ImageCarouselWrapper';
import { projectsData } from '@/constants/projects';
import Layout from '@/layouts/Layout.astro';
import type { Project } from '@/types/projects';

// Astro의 동적 라우팅을 위한 getStaticPaths 함수 추가
export function getStaticPaths() {
  // 모든 프로젝트를 하나의 배열로 합치기
  const allProjects: Project[] = projectsData.flatMap(
    (yearData) => yearData.projects,
  );

  return allProjects.map((project) => ({
    params: { id: project.id },
    props: { project, allProjects },
  }));
}

// getStaticPaths에서 전달받은 props
const { project } = Astro.props;

// 프로젝트가 undefined인 경우 404 페이지로 리다이렉트
if (!project) {
  return Astro.redirect('/404');
}

// 이미지 관련 변수 계산
const fullImages = project.images?.full || [];
const hasRightImages = fullImages.length > 0;
const hasBottomImages = fullImages.length > 4;
const rightImages = fullImages.slice(0, 4);
const bottomImages = fullImages.slice(4);

// 모든 이미지 배열 생성 (썸네일 + 전체 이미지)
const allImages = [project.images.thumbnail, ...fullImages];
---

<Layout
  title={`${project.title} | 훤다 포트폴리오`}
  description={project.description.short}
>
  <main class="container mx-auto px-4 py-16 sm:px-8 md:px-10 lg:px-20 xl:px-40">
    <div class="my-8 w-fit">
      <a
        href="/projects"
        class="text-accent-1 hover:bg-gray9 flex items-center gap-2 rounded-full p-2 pr-3 opacity-85 hover:opacity-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        모든 프로젝트 보기
      </a>
    </div>

    <div class="mb-8 space-y-4">
      <h1 class="font-pretendard text-4xl font-bold">{project.title}</h1>
      <div class="flex flex-wrap gap-2">
        {
          project.techStack?.map((tech) => (
            <span class="text-gray-1 border-accent-2 relative rounded-full border px-3 py-1 text-sm">
              <span class="from-accent-2 to-accent-4 absolute inset-0 rounded-full bg-gradient-to-r opacity-20" />
              <span class="bg-gray-8 absolute inset-[1px] rounded-full" />
              <span class="text-gray-1 relative z-10">{tech}</span>
            </span>
          ))
        }
      </div>
      <div class="flex flex-col gap-4">
        <p class="text-gray-2 text-lg">{project.description.short}</p>
        <p
          class="from-gray9 to-gray8 text-main rounded-lg bg-gradient-to-b p-4 leading-relaxed whitespace-pre-line"
        >
          {project.description.full}
        </p>
      </div>

      <div class="mb-6 flex flex-wrap gap-4">
        {
          project.urls?.demo && (
            <a
              href={project.urls.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent-1 hover:bg-accent-1/90 text-inverse inline-block rounded px-6 py-3 font-medium transition-colors"
            >
              프로젝트 보기
            </a>
          )
        }
        {
          project.urls?.github && (
            <a
              href={project.urls.github}
              target="_blank"
              rel="noopener noreferrer"
              class="border-gray3 text-main hover:bg-gray9 inline-block rounded border px-6 py-3 font-medium transition-colors"
            >
              GitHub 저장소
            </a>
          )
        }
      </div>
    </div>

    <div class="mb-3 flex flex-col gap-3 lg:flex-row">
      <div
        class="bg-gray8 image-gallery aspect-video cursor-pointer overflow-hidden rounded-lg lg:w-1/2"
        data-image-index="0"
      >
        <img
          src={project.images.thumbnail}
          alt={`${project.title} 메인 이미지`}
          class="h-full w-full object-cover"
        />
      </div>
      {
        hasRightImages && (
          <div class="grid grid-cols-2 grid-rows-2 gap-3 lg:w-1/2">
            {rightImages.map((image, index) => (
              <div
                class="bg-gray8 image-gallery aspect-video cursor-pointer overflow-hidden rounded-lg"
                data-image-index={index + 1}
              >
                <img
                  src={image}
                  alt={`${project.title} 이미지 ${index + 1}`}
                  class="h-full w-full object-cover"
                />
              </div>
            ))}
          </div>
        )
      }
    </div>

    {
      hasBottomImages && (
        <div class="mb-12">
          <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            {bottomImages.map((image, index) => (
              <div
                class="bg-gray8 image-gallery aspect-video cursor-pointer overflow-hidden rounded-lg"
                data-image-index={index + 5}
              >
                <img
                  src={image}
                  alt={`${project.title} 이미지 ${index + 5}`}
                  class="h-full w-full object-cover"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="mb-12">
      <h2 class="font-pretendard mb-6 text-2xl font-bold">프로젝트 개요</h2>
      <div class="bg-gray8 rounded-lg p-6">
        <div class="text-gray-1 whitespace-pre-line">
          {project.description.full}
        </div>
      </div>
    </div>

    {
      project.points && project.points.length > 0 && (
        <div class="mb-12 grid gap-8 md:grid-cols-3">
          {project.points[0].challenges && (
            <div>
              <h2 class="font-pretendard mb-4 text-xl font-bold">도전 과제</h2>
              <div class="bg-gray8 h-full rounded-lg p-6">
                <div class="text-gray-2 whitespace-pre-line">
                  {project.points[0].challenges}
                </div>
              </div>
            </div>
          )}
          {project.points[0].solutions && (
            <div>
              <h2 class="font-pretendard mb-4 text-xl font-bold">해결 방법</h2>
              <div class="bg-gray8 h-full rounded-lg p-6">
                <div class="text-gray-2 whitespace-pre-line">
                  {project.points[0].solutions}
                </div>
              </div>
            </div>
          )}
          {project.points[0].results && (
            <div>
              <h2 class="font-pretendard mb-4 text-xl font-bold">결과</h2>
              <div class="bg-gray8 h-full rounded-lg p-6">
                <div class="text-gray-2 whitespace-pre-line">
                  {project.points[0].results}
                </div>
              </div>
            </div>
          )}
        </div>
      )
    }
  </main>

  <ImageCarouselWrapper
    client:load
    images={allImages}
    captions={project.images.captions || []}
  />
</Layout>
