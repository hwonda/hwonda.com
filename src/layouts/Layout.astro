---
import '../styles/global.css';

import Font from '../components/Font.astro';
import Header from '../components/ui/Header.tsx';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '훤다의 프론트엔드 개발 포트폴리오입니다. React, TypeScript, Astro 등을 활용한 프로젝트를 확인해보세요.',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="훤다" />
    <meta
      name="keywords"
      content="포트폴리오, 프론트엔드, 개발자, React, Astro, TypeScript"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hwonda.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://hwonda.com/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <Font />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <main class="container min-w-screen">
      <div
        class="fixed top-4 z-50 w-full px-4 sm:px-8 md:px-10 lg:px-20 xl:px-40"
      >
        <Header client:load />
      </div>
      <slot />
    </main>
  </body>
</html>
