---
import { getTodayDate } from '@/utils/dateUtils';

import About from './About';
import Hero from './Hero';
import Projects from './Projects';
import Recommendation from './Recommendation';

interface Props {
  basePath: '/fe' | '/pm';
  role: 'fe' | 'pm';
}

const { basePath, role } = Astro.props;
const lastModified = getTodayDate();
---

<>
  <Hero client:load role={role} lastModified={lastModified} />

  <div class="flex flex-col px-4 sm:px-8 md:px-10 lg:px-20 xl:px-40">
    <Recommendation client:visible role={role} />
    <Projects client:visible basePath={basePath} role={role} />
    <About client:visible basePath={basePath} role={role} />
  </div>
</>
