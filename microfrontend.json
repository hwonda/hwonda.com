{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "web": {
      "routing": [
        {
          "paths": [
            "/",
            "/:path*"
          ]
        }
      ]
    },
    "blog": {
      "routing": [
        {
          "paths": [
            "/blog",
            "/blog/:path*"
          ]
        }
      ]
    }
  }
}